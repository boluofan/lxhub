# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 运行时数据 ----------
# SQLite 数据库及 WAL/SHM 附属文件，每次爬取都会变化
data/
*.db
*.db-wal
*.db-shm
# 本地化输出（compose 默认挂载到 ./outjs，内容是自动生成的可再生脚本）
outjs/

# ---------- 本地导出 ----------
# 手动导出请写到其他路径，例如：python main.py export --out /tmp/export.json
site/

# ---------- 系统与编辑器 ----------
.DS_Store
._*
Thumbs.db
*.swp
*.swo

# ---------- IDE ----------
.idea/
.vscode/
.codebuddy/

# ---------- 智能体内部记忆（非项目代码） ----------
.workbuddy/

# ---------- 环境变量 ----------
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log
